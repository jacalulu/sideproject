# Builds the Capacitor iOS app and uploads it to TestFlight.
# Runs in GitHub Actions on a macOS runner — see .github/workflows/ios-testflight.yml
default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_KEY_B64"),
      is_key_content_base64: true
    )

    team_id = ENV.fetch("APPLE_TEAM_ID")
    app_id  = "com.jacalulu.mermaiddots"

    # A signing certificate is usable only together with its private key, and
    # the runner is destroyed after every job. Cloud-managed signing therefore
    # had nothing to reuse and minted a fresh Apple Development certificate on
    # each run — runs #7 and #8 signed with different identities (0225146D…
    # then 546E1FB6…), five of which accumulated on the account. It never
    # produced a distribution identity at all, which is why every archive
    # succeeded and every export failed.
    #
    # So the certificate is supplied rather than created: generated once off
    # CI, held as an encrypted secret, and imported into a throwaway keychain
    # here. Provisioning profiles are still fetched per run — unlike
    # certificates they carry no private key and are freely regenerated.
    setup_ci

    keychain_name = ENV.fetch("MATCH_KEYCHAIN_NAME", "fastlane_tmp_keychain")
    keychain_pass = ENV.fetch("MATCH_KEYCHAIN_PASSWORD", "")

    # The Apple WWDR intermediate must be present before the leaf certificate
    # counts as a usable identity: `security find-identity -v -p codesigning`
    # lists only identities whose chain resolves to a trusted root, and our
    # .p12 carries the leaf and its private key alone. A developer's Mac has
    # this intermediate installed by Xcode; a bare runner does not.
    import_certificate(
      certificate_path: ENV.fetch("WWDR_CERT_PATH"),
      keychain_name: keychain_name,
      keychain_password: keychain_pass
    )

    import_certificate(
      certificate_path: ENV.fetch("IOS_DIST_CERT_PATH"),
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: keychain_name,
      keychain_password: keychain_pass
    )

    # import_certificate reports a failed PKCS#12 import as an ERROR log line
    # and lets the lane continue. In run #10 that turned an unreadable .p12
    # into a confusing failure two actions later, inside sigh, as "Could not
    # find a matching code signing identity". Assert the identity is actually
    # present so the lane stops at the step that went wrong.
    identities = sh("security find-identity -v -p codesigning || true", log: false)
    UI.command_output(identities.strip)
    unless identities.include?("Apple Distribution")
      UI.user_error!(
        "No Apple Distribution identity in the keychain after import. " \
        "The certificate did not import — check the import_certificate step " \
        "above for the reason (a PKCS#12 written with algorithms macOS does " \
        "not support reports itself as a wrong password)."
      )
    end

    sigh(
      api_key: api_key,
      team_id: team_id,
      app_identifier: app_id,
      platform: "ios",
      development: false
    )
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # Monotonic build number so every CI run is accepted by App Store Connect
    increment_build_number(
      xcodeproj: "ios/App/App.xcodeproj",
      build_number: ENV.fetch("GITHUB_RUN_NUMBER", Time.now.to_i.to_s)
    )

    # Manual signing throughout. The archive is signed for distribution
    # directly, so no development certificate is required and nothing is
    # created on the Apple account per run.
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "DEVELOPMENT_TEAM=#{team_id} " \
              "CODE_SIGN_STYLE=Manual " \
              "CODE_SIGN_IDENTITY='Apple Distribution' " \
              "PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { app_id => profile_name }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
